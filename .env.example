# Server Configuration
NODE_ENV=development
PORT=3000

# Security & CORS Configuration
# Comma-separated list of allowed origins for cross-origin browser requests
CORS_ALLOWED_ORIGINS=https://cynbit.com,https://app.cynbit.com

# Optional Redis URL for distributed sliding-window rate limiting
# Falls back to bounded in-memory sliding-window store when omitted
# REDIS_URL=redis://127.0.0.1:6379

# API Documentation Base URI for RFC 9457 Problem Details `type` URIs
PROBLEM_BASE_URI=https://api.cynbit.com/problems
